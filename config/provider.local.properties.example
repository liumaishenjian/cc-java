# Copy this file to provider.local.properties on each computer.
# provider.local.properties is Git-ignored and must never be committed.
openai.base-url=
openai.api-key=
openai.model=

# Optional S14 second Provider; values remain empty in the tracked template.
anthropic.base-url=
anthropic.api-key=
anthropic.model=

# Optional S15 controlled hosted MCP search; disabled by default and credentials stay empty.
# Supported providers: exa (works without a key; optional key uses provider-fixed query auth) or parallel (Bearer).
web-search.enabled=
web-search.provider=
web-search.api-key=
